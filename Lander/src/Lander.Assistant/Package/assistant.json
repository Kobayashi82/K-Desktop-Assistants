{
  "$schema": "../../../../../docs/assistant/esquemas/assistant.schema.json",
  "id": "lander",
  "name": "Lander",
  "version": "0.8.1",
  "author": "Kobayashi82",
  "description": {
    "es": "Un pequeño módulo lunar que vuela por tus ventanas y aterriza en ellas. Incluye su juego.",
    "en": "A little lunar module that flies around your windows and lands on them. Game included.",
    "fr": "Un petit module lunaire qui vole autour de vos fenêtres et s’y pose. Jeu inclus.",
    "de": "Eine kleine Mondfähre, die um deine Fenster fliegt und auf ihnen landet. Mit Spiel.",
    "it": "Un piccolo modulo lunare che vola tra le tue finestre e ci atterra sopra. Gioco incluso.",
    "pt": "Um pequeno módulo lunar que voa pelas suas janelas e pousa nelas. Com jogo incluído."
  },
  "homepage": "https://github.com/Kobayashi82/K-Desktop-Assistants",
  "license": "MIT",
  "sdk": "1.2",
  "entry": "lib/Lander.Assistant.dll!Lander.Assistant.LanderAssistant",
  "icon": "icon.png",
  "wakeWord": "Lander",
  "voice": "voice/lander.json",
  "persona": "persona/{lang}.json",
  "traits": {
    "travel": "fly",
    "travelSpeed": 900,
    "canMoveWindows": false,
    "canReachMaximized": false,
    "gestures": ["communicate", "react"]
  },
  "extras": [
    {
      "id": "lander.manual",
      "name": { "es": "Modo manual", "en": "Manual mode", "fr": "Mode manuel", "de": "Manueller Modus", "it": "Modalità manuale", "pt": "Modo manual" },
      "icon": "kd:XboxController",
      "hotkey": "CTRL + ALT + L"
    },
    {
      "id": "lander.mission.accept",
      "name": { "es": "Aceptar la misión", "en": "Accept the mission", "fr": "Accepter la mission", "de": "Mission annehmen", "it": "Accetta la missione", "pt": "Aceitar a missão" },
      "icon": "kd:CheckmarkCircle"
    },
    {
      "id": "lander.mission",
      "name": { "es": "Proponer una misión", "en": "Offer a mission", "fr": "Proposer une mission", "de": "Eine Mission anbieten", "it": "Proponi una missione", "pt": "Propor uma missão" },
      "icon": "kd:Target"
    },
    {
      "id": "lander.race",
      "name": { "es": "Empezar una carrera", "en": "Start a race", "fr": "Lancer une course", "de": "Ein Rennen starten", "it": "Inizia una gara", "pt": "Começar uma corrida" },
      "icon": "kd:Flag"
    },
    {
      "id": "lander.race.repeat",
      "name": { "es": "Repetir la carrera", "en": "Repeat the race", "fr": "Refaire la course", "de": "Rennen wiederholen", "it": "Ripeti la gara", "pt": "Repetir a corrida" },
      "icon": "kd:ArrowRepeatAll"
    },
    {
      "id": "lander.race.abandon",
      "name": { "es": "Abandonar la carrera", "en": "Abandon the race", "fr": "Abandonner la course", "de": "Rennen abbrechen", "it": "Abbandona la gara", "pt": "Abandonar a corrida" },
      "icon": "kd:DismissCircle"
    }
  ]
}
