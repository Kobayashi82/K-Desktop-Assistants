{
  "$schema": "../../../../../docs/assistant/schemas/assistant.schema.json",
  "id": "lander",
  "name": "Lander",
  "version": "0.17.0",
  "author": "Kobayashi82",
  "description": {
    "es": "Un pequeño módulo lunar que vuela por tus ventanas y aterriza en ellas. Incluye su juego.",
    "en": "A little lunar module that flies around your windows and lands on them. Game included.",
    "fr": "Un petit module lunaire qui vole autour de vos fenêtres et s’y pose. Jeu inclus.",
    "de": "Eine kleine Mondfähre, die um deine Fenster fliegt und auf ihnen landet. Mit Spiel.",
    "it": "Un piccolo modulo lunare che vola tra le tue finestre e ci atterra sopra. Gioco incluso.",
    "pt": "Um pequeno módulo lunar que voa pelas suas janelas e pousa nelas. Com jogo incluído."
  },
  "homepage": "https://github.com/Kobayashi82/K-Desktop-Assistants",
  "license": "MIT",
  "changes": {
    "es": "Ahora enseña en el catálogo lo que sabe hacer: clips de sus entradas, salidas, estados, reacciones y animaciones.",
    "en": "It now shows what it can do in the catalog: clips of its entrances, exits, states, reactions and animations.",
    "fr": "Il montre maintenant ce qu’il sait faire dans le catalogue : des clips de ses entrées, sorties, états, réactions et animations.",
    "de": "Zeigt jetzt im Katalog, was er kann: Clips seiner Auftritte, Abgänge, Zustände, Reaktionen und Animationen.",
    "it": "Ora mostra nel catalogo cosa sa fare: clip delle sue entrate, uscite, stati, reazioni e animazioni.",
    "pt": "Agora mostra no catálogo o que sabe fazer: clipes das suas entradas, saídas, estados, reações e animações."
  },
  "sdk": "1.21",
  "common": ["size", "volume", "liveliness", "dragging"],
  "entry": "lib/Lander.Assistant.dll!Lander.Assistant.LanderAssistant",
  "icon": "icon.png",
  "wakeWord": "Lander",
  "model": { "suggested": ["unsloth/Qwen3.5-9B-GGUF:Q4_K_M", "unsloth/Qwen3.5-4B-GGUF:Q4_K_M"] },
  "voice": "voice/lander.json",
  "persona": "persona/{lang}.json",
  "traits": {
    "travel": "fly",
    "travelSpeed": 900,
    "canMoveWindows": true,
    "canReachMaximized": true,
    "gestures": ["communicate", "react", "pressButton", "activateWindow", "pointAt", "goTo", "mark", "scan", "typing", "waitForWindow", "moveWindow", "announce"]
  },
  "extras": [
    {
      "id": "lander.manual",
      "name": { "es": "Modo manual", "en": "Manual mode", "fr": "Mode manuel", "de": "Manueller Modus", "it": "Modalità manuale", "pt": "Modo manual" },
      "icon": "kd:XboxController",
      "hotkey": "CTRL + ALT + L"
