root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,xml,xaml,manifest}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Organización
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# Estilo
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_new_line_before_open_brace = all

# Nombres: campos privados con _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_fields.required_modifiers =
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# Constantes privadas en PascalCase (tiene prioridad sobre la regla anterior)
dotnet_naming_rule.private_consts_pascal.symbols = private_consts
dotnet_naming_rule.private_consts_pascal.style = pascal
dotnet_naming_rule.private_consts_pascal.severity = suggestion
dotnet_naming_symbols.private_consts.applicable_kinds = field
dotnet_naming_symbols.private_consts.applicable_accessibilities = private
dotnet_naming_symbols.private_consts.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# Interop: los nombres de Win32 se mantienen tal cual
[**/Interop/**.cs]
dotnet_naming_rule.private_fields_underscore.severity = none
dotnet_diagnostic.IDE1006.severity = none

# Las mismas excepciones que K-Desktop (su .editorconfig): nombres de Win32, resultados de Win32 que no importan,
# palabras clave de VB e interfaces a propósito.
[*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1806.severity = none
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1859.severity = none
