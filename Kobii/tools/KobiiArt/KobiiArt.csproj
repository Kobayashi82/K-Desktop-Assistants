<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dibuja las imágenes del paquete con el dibujo vectorial de Kobii (icono y galería de colores): «dotnet run» en esta
    carpeta. Las deja en src\Kobii.Assistant\Package (o en la carpeta que se le pase). «vsheet <archivo.png> [dark]
    [only=grupo]» hace una hoja con colores, caras y posturas; «vbench» mide lo que cuesta grabar un fotograma.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Kobii.Assistant\Kobii.Assistant.csproj" />
    <ProjectReference Include="$(AssistantSdkProject)" />
  </ItemGroup>

</Project>
