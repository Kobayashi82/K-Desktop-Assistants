                { "id": "sky", "name": { "es": "Cielo", "en": "Sky", "fr": "Ciel", "de": "Himmel", "it": "Cielo", "pt": "Céu" }, "image": "assets/colors/sky.png" },
                { "id": "peach", "name": { "es": "Melocotón", "en": "Peach", "fr": "Pêche", "de": "Pfirsich", "it": "Pesca", "pt": "Pêssego" }, "image": "assets/colors/peach.png" },
