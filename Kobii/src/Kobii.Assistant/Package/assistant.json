{
  "$schema": "../../../../../src/KDesktop.Core/Assistant/Packages/Schemas/assistant.schema.json",
  "id": "kobii",
  "name": "Kobii",
  "version": "0.14.0",
  "author": "Kobayashi82",
  "description": {
    "es": "Una criatura blandita que pasea por tu barra de tareas y por encima de tus ventanas.",
    "en": "A squishy little creature that wanders along your taskbar and over your windows.",
    "fr": "Une petite créature toute douce qui se promène sur ta barre des tâches et sur tes fenêtres.",
    "de": "Ein weiches kleines Wesen, das über deine Taskleiste und deine Fenster spaziert.",
    "it": "Una creaturina morbida che passeggia sulla barra delle applicazioni e sopra le tue finestre.",
    "pt": "Uma criaturinha fofinha que passeia pela sua barra de tarefas e por cima das suas janelas."
  },
  "changes": {
    "es": "Preparado para el SDK 1.0 de los asistentes: necesita K-Desktop 5.0.197 o posterior.",
    "en": "Ready for the assistant SDK 1.0: it needs K-Desktop 5.0.197 or later.",
    "fr": "Prêt pour le SDK 1.0 des assistants : il faut K-Desktop 5.0.197 ou plus récent.",
    "de": "Bereit für das Assistenten-SDK 1.0: braucht K-Desktop 5.0.197 oder neuer.",
    "it": "Pronto per l’SDK 1.0 degli assistenti: serve K-Desktop 5.0.197 o successivo.",
    "pt": "Pronto para o SDK 1.0 dos assistentes: precisa do K-Desktop 5.0.197 ou mais recente."
  },
  "homepage": "https://github.com/Kobayashi82/K-Desktop-Assistants",
  "license": "MIT",
  "sdk": "1.0",
  "updates": "https://github.com/Kobayashi82/K-Desktop/releases/download/assistants/kobii.kai",
  "common": ["size", "volume", "liveliness", "dragging"],
  "entry": "lib/Kobii.Assistant.dll!Kobii.Assistant.KobiiAssistant",
  "icon": "icon.png",
  "wakeWord": "Kobii",
  "voice": "voice/kobii.json",
  "persona": "persona/{lang}.json",
  "traits": {
    "travel": "walk",
    "travelSpeed": 80,
    "canMoveWindows": true,
    "canReachMaximized": false,
    "gestures": [
      "communicate",
      "react",
      "pressButton",
      "activateWindow",
      "moveWindow",
      "pointAt",
      "goTo",
      "mark",
      "scan",
      "typing",
      "waitForWindow",
      "announce"
    ]
  },
