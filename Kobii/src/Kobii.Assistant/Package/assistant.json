{
  "$schema": "../../../../../docs/assistant/esquemas/assistant.schema.json",
  "id": "kobii",
  "name": "Kobii",
  "version": "0.8.0",
  "author": "Kobayashi82",
  "description": {
    "es": "Una criatura blandita que pasea por tu barra de tareas y por encima de tus ventanas.",
    "en": "A squishy little creature that wanders along your taskbar and over your windows.",
    "fr": "Une petite créature toute douce qui se promène sur ta barre des tâches et sur tes fenêtres.",
    "de": "Ein weiches kleines Wesen, das über deine Taskleiste und deine Fenster spaziert.",
    "it": "Una creaturina morbida che passeggia sulla barra delle applicazioni e sopra le tue finestre.",
    "pt": "Uma criaturinha fofinha que passeia pela sua barra de tarefas e por cima das suas janelas."
  },
  "changes": {
    "es": "El tamaño, el volumen, lo movido que es y cogerlo con el ratón están ahora en la pestaña «General» de su ficha, igual que en los demás asistentes.",
    "en": "Size, volume, how lively it is and picking it up with the mouse are now in the «General» tab of its card, as for every other assistant.",
    "fr": "La taille, le volume, la vivacité et l’attraper avec la souris sont maintenant dans l’onglet « Général » de sa fiche, comme pour les autres assistants.",
    "de": "Größe, Lautstärke, Lebhaftigkeit und das Greifen mit der Maus stehen jetzt im Reiter „Allgemein“ seiner Karte, wie bei den anderen Assistenten.",
    "it": "Dimensione, volume, vivacità e prenderlo con il mouse sono ora nella scheda «Generale» della sua scheda, come per gli altri assistenti.",
    "pt": "Tamanho, volume, agitação e pegar com o mouse agora ficam na aba «Geral» da ficha dele, como nos outros assistentes."
  },
  "homepage": "https://github.com/Kobayashi82/K-Desktop-Assistants",
  "license": "MIT",
  "sdk": "1.9",
  "common": ["size", "volume", "liveliness", "dragging"],
  "entry": "lib/Kobii.Assistant.dll!Kobii.Assistant.KobiiAssistant",
  "icon": "icon.png",
  "wakeWord": "Kobii",
  "voice": "voice/kobii.json",
  "persona": "persona/{lang}.json",
  "traits": {
    "travel": "walk",
    "travelSpeed": 80,
    "canMoveWindows": true,
    "canReachMaximized": false,
    "gestures": [
      "communicate",
      "react",
      "pressButton",
      "activateWindow",
      "moveWindow",
      "pointAt",
      "goTo",
      "mark",
      "scan",
      "typing",
      "waitForWindow"
    ]
  },
  "extras": [
    {
      "id": "kobii.feed",
      "name": {
        "es": "Darle de comer",
        "en": "Give it something to eat",
        "fr": "Lui donner à manger",
        "de": "Etwas zu essen geben",
        "it": "Dargli da mangiare",
        "pt": "Dar comida"
      },
      "icon": "kd:FoodApple"
    },
    {
      "id": "kobii.drink",
      "name": {
        "es": "Darle de beber",
        "en": "Give it something to drink",
        "fr": "Lui donner à boire",
