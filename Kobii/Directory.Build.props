<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..'))" />

  <PropertyGroup>
    <!-- La versión del asistente es la de Package\assistant.json; esta solo marca los ensamblados. -->
    <Version>0.5.0</Version>
    <Product>Kobii</Product>
    <Description>Kobii como asistente de K-Desktop: una criatura que vive sobre tus ventanas.</Description>
  </PropertyGroup>

</Project>
