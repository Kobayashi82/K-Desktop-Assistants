{
  "$schema": "../../../../../src/KDesktop.Core/Assistant/Packages/Schemas/assistant.schema.json",
  "id": "kumo",
  "name": "Kumo",
  "version": "0.2.0",
  "author": "Kobayashi82",
  "description": {
    "es": "Una nube ámbar que flota sobre tus ventanas, cambia de forma sin parar y te habla en su propia nube.",
    "en": "An amber cloud that floats over your windows, never stops changing shape and talks to you in its own cloud.",
    "fr": "Un nuage ambré qui flotte au-dessus de tes fenêtres, change de forme sans arrêt et te parle dans son propre nuage.",
    "de": "Eine bernsteinfarbene Wolke, die über deinen Fenstern schwebt, ständig ihre Form ändert und in ihrer eigenen Wolke mit dir spricht.",
    "it": "Una nuvola ambrata che fluttua sopra le tue finestre, cambia forma senza sosta e ti parla nella sua nuvola.",
    "pt": "Uma nuvem âmbar que flutua sobre as suas janelas, muda de forma sem parar e fala com você na própria nuvem."
  },
  "homepage": "https://github.com/Kobayashi82/K-Desktop-Assistants",
  "license": "MIT",
  "changes": {
    "es": "Preparado para el SDK 1.0 de los asistentes: necesita K-Desktop 5.0.197 o posterior.",
    "en": "Ready for the assistant SDK 1.0: it needs K-Desktop 5.0.197 or later.",
    "fr": "Prêt pour le SDK 1.0 des assistants : il faut K-Desktop 5.0.197 ou plus récent.",
    "de": "Bereit für das Assistenten-SDK 1.0: braucht K-Desktop 5.0.197 oder neuer.",
    "it": "Pronto per l’SDK 1.0 degli assistenti: serve K-Desktop 5.0.197 o successivo.",
    "pt": "Pronto para o SDK 1.0 dos assistentes: precisa do K-Desktop 5.0.197 ou mais recente."
  },
  "sdk": "1.0",
  "updates": "https://github.com/Kobayashi82/K-Desktop/releases/download/assistants/kumo.kai",
  "common": ["size", "volume", "liveliness", "dragging"],
  "entry": "lib/Kumo.Assistant.dll!Kumo.Assistant.KumoAssistant",
  "icon": "icon.png",
  "wakeWord": "Kumo",
  "speech": "own",
  "voice": "voice/kumo.json",
  "persona": "persona/{lang}.json",
  "extras": [
    {
      "id": "kumo.rainbow",
      "name": {"es":"Hacer un arcoíris","en":"Make a rainbow","fr":"Faire un arc-en-ciel","de":"Einen Regenbogen machen","it":"Fare un arcobaleno","pt":"Fazer um arco-íris"},
      "icon": "kd:WeatherSunny"
    },
    {
      "id": "kumo.drizzle",
      "name": {"es":"Llovizna","en":"Drizzle","fr":"Bruine","de":"Nieselregen","it":"Pioggerellina","pt":"Garoa"},
      "icon": "kd:WeatherDrizzle"
    },
    {
      "id": "kumo.drop",
      "name": {"es":"Hacerse gota","en":"Turn into a drop","fr":"Devenir une goutte","de":"Zum Tropfen werden","it":"Diventare una goccia","pt":"Virar uma gota"},
      "icon": "kd:Drop"
    },
    {
      "id": "kumo.nap",
      "name": {"es":"Echarse la siesta","en":"Take a nap","fr":"Faire la sieste","de":"Ein Nickerchen machen","it":"Fare un pisolino","pt":"Tirar uma soneca"},
